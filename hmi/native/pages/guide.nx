  if(home.online.val==1&&gBusy.val==0&&gCount.val>4&&gCount.val<=5)
  {
  gBusy.val=1
  prints "RC6:STEP:4",0
  printh ff ff ff
  }

on bObs0.up:
  if(home.online.val==1&&gBusy.val==0&&gCount.val>0&&gCount.val>5)
  {
  gBusy.val=1
  prints "RC6:STEP:0",0
  printh ff ff ff
  }

