on hArt.up:
  if(gArt.val==0)
  {
  pArt.pic=18
  }
  if(gArt.val==1)
  {
  pArt.pic=19
  }
  if(gArt.val==2)
  {
  pArt.pic=20
  }
  if(gArt.val==3)
  {
  pArt.pic=21
  }
  if(gArt.val==4)
  {
  pArt.pic=22
  }
  if(gArt.val==5)
  {
  pArt.pic=23
  }
  if(gArt.val==6)
  {
  pArt.pic=24
  }
  if(gArt.val==7)
  {
  pArt.pic=25
  }
  if(gArt.val==8)
  {
  pArt.pic=26
  }
  if(gArt.val==9)
  {
  pArt.pic=27
  }
  if(gArt.val==10)
  {
  pArt.pic=28
  }
  if(gArt.val==11)
  {
  pArt.pic=29
  }
  if(gArt.val==12)
  {
  pArt.pic=30
  }

on bStep0.up:
  if(home.online.val==1&&gBusy.val==0&&gCount.val>0&&gCount.val<=5)
  {
  gBusy.val=1
  prints "RC6:STEP:0",0
  printh ff ff ff
  }

on bStep1.up:
  if(home.online.val==1&&gBusy.val==0&&gCount.val>1&&gCount.val<=5)
  {
  gBusy.val=1
  prints "RC6:STEP:1",0
  printh ff ff ff
  }

on bStep2.up:
  if(home.online.val==1&&gBusy.val==0&&gCount.val>2&&gCount.val<=5)
  {
  gBusy.val=1
  prints "RC6:STEP:2",0
  printh ff ff ff
  }

