on bManual.up:
  if(home.online.val==1&&iAvailable.val==1)
  {
  prints "RC6:MANUAL",0
  printh ff ff ff
  }else
  {
  if(home.lang.val==1)
  {
  iMessage.txt="No confirmed import is available yet."
  }else
  {
  iMessage.txt="Noch kein bestätigter Speicherimport verfügbar."
  }
  }

on bBack.up:
  if(home.online.val==1)
  {
  prints "RC6:BACK",0
  printh ff ff ff
  }else
  {
  page entry
  }

on bHelp.up:
  prints "RC6:HELP",0
  printh ff ff ff

on tmFlow.timer:
  if(iAdvance.val==1&&home.online.val==1)
  {
  iAdvance.val=0
  page tester
  }else if(iAdvance.val==2)
  {
  iAdvance.val=0
  if(entry.guided.val==1)
  {
  page guide
  }else
  {
  page entry
  }
  }
  if(home.online.val==0)
  {
  if(home.lang.val==1)
  {
  iStatus.txt="Host disconnected. Check the connection."
  }else
  {
  iStatus.txt="Host getrennt. Verbindung prüfen."
  }
  iAvailable.val=0
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  iBody.txt="Waiting for host ..."
  }else
  {
  iBody.txt="Warte auf Host ..."
  }
  if(home.lang.val==1)
  {
  bManual.txt="Select saved reading"
  }else
  {
  bManual.txt="Vorhandene Messung wählen"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  bHelp.txt="Help"
  }else
  {
  bHelp.txt="Hilfe"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=52
  }else
  {
  pLabel0.pic=51
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=54
  }else
  {
  pLabel1.pic=53
  }

on importer.loadend:
  click hLocale,0
  sendme
