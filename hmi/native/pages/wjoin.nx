on bJoin.up:
  if(home.online.val==1)
  {
  if(jMode.val==1)
  {
  jMode.val=0
  prints "RC4:JOIN",0
  printh ff ff ff
  }else if(jMode.val==2)
  {
  entry.field.val=2
  page keyboard
  }
  }

on bBack.up:
  page wifi

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  jName.txt="No network selected"
  }else
  {
  jName.txt="Kein Netz ausgewählt"
  }
  if(home.lang.val==1)
  {
  bJoin.txt="Connect / password"
  }else
  {
  bJoin.txt="Verbinden / Passwort"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=115
  }else
  {
  pLabel0.pic=114
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=117
  }else
  {
  pLabel1.pic=116
  }

on wjoin.loadend:
  click hLocale,0
  sendme
