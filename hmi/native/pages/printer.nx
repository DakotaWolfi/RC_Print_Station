on bHost.up:
  if(home.online.val==1)
  {
  settings.editText.txt=pHost.txt
  entry.field.val=3
  page keyboard
  }

on bPort.up:
  if(home.online.val==1)
  {
  settings.editText.txt=pPort.txt
  entry.field.val=4
  page keyboard
  }

on bProbe.up:
  if(home.online.val==1)
  {
  prints "RC4:PROBE",0
  printh ff ff ff
  }

on bTest.up:
  if(home.online.val==1)
  {
  prints "RC4:TEST",0
  printh ff ff ff
  }

on bBack.up:
  page settings

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  bHost.txt="Change"
  }else
  {
  bHost.txt="Ändern"
  }
  if(home.lang.val==1)
  {
  bPort.txt="Change"
  }else
  {
  bPort.txt="Ändern"
  }
  if(home.lang.val==1)
  {
  bProbe.txt="Test TCP connection"
  }else
  {
  bProbe.txt="TCP-Verbindung testen"
  }
  if(home.lang.val==1)
  {
  bTest.txt="Print test receipt"
  }else
  {
  bTest.txt="Testbeleg drucken"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=69
  }else
  {
  pLabel0.pic=68
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=71
  }else
  {
  pLabel1.pic=70
  }
  if(home.lang.val==1)
  {
  pLabel2.pic=73
  }else
  {
  pLabel2.pic=72
  }
  if(home.lang.val==1)
  {
  pLabel3.pic=75
  }else
  {
  pLabel3.pic=74
  }

on printer.loadend:
  click hLocale,0
  sendme
