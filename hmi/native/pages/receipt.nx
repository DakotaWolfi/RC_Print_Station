on rGraphic.up:
  if(home.online.val==1)
  {
  prints "RC4:GRAPH",0
  printh ff ff ff
  }

on bFeedDown.up:
  if(home.online.val==1)
  {
  prints "RC4:FEED-",0
  printh ff ff ff
  }

on bFeedUp.up:
  if(home.online.val==1)
  {
  prints "RC4:FEED+",0
  printh ff ff ff
  }

on rDensity.up:
  if(home.online.val==1)
  {
  prints "RC4:DENSITY",0
  printh ff ff ff
  }

on bBack.up:
  page settings

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  rGraphic.txt="Header: graphic"
  }else
  {
  rGraphic.txt="Kopf: Grafik"
  }
  if(home.lang.val==1)
  {
  rDensity.txt="Printer default"
  }else
  {
  rDensity.txt="Druckervorgabe"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=87
  }else
  {
  pLabel0.pic=86
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=89
  }else
  {
  pLabel1.pic=88
  }
  if(home.lang.val==1)
  {
  pLabel2.pic=91
  }else
  {
  pLabel2.pic=90
  }
  if(home.lang.val==1)
  {
  pLabel3.pic=93
  }else
  {
  pLabel3.pic=92
  }

on receipt.loadend:
  click 14,0
  sendme
