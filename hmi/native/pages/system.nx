on bBrightDown.up:
  if(home.online.val==1)
  {
  prints "RC4:BR-",0
  printh ff ff ff
  }

on bBrightUp.up:
  if(home.online.val==1)
  {
  prints "RC4:BR+",0
  printh ff ff ff
  }

on bStand.up:
  if(home.online.val==1)
  {
  prints "RC4:STANDBY",0
  printh ff ff ff
  }

on bPower.up:
  page power

on bBack.up:
  page settings

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  sStand.txt="Off"
  }else
  {
  sStand.txt="Aus"
  }
  if(home.lang.val==1)
  {
  bStand.txt="Change"
  }else
  {
  bStand.txt="Ändern"
  }
  if(home.lang.val==1)
  {
  bPower.txt="Restart / shut down"
  }else
  {
  bPower.txt="Neustart / Ausschalten"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=106
  }else
  {
  pLabel0.pic=105
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=108
  }else
  {
  pLabel1.pic=107
  }
  if(home.lang.val==1)
  {
  pLabel2.pic=110
  }else
  {
  pLabel2.pic=109
  }

on system.loadend:
  click 15,0
  sendme
