on hEdit0.up:
  if(busy.val==0)
  {
  field.val=0
  page keyboard
  }

on bTemplates.up:
  if(busy.val==0&&home.online.val==1)
  {
  prints "RC61:APPLIANCES",0
  printh ff ff ff
  picker.pBack.val=0
  page picker
  }

on hEdit1.up:
  if(busy.val==0)
  {
  field.val=1
  page keyboard
  }

on hEdit2.up:
  if(busy.val==0&&useLast.val==0&&sim.val==0)
  {
  field.val=5
  page keyboard
  }

on cLast.up:
  useLast.val=cLast.val
  if(useLast.val==1)
  {
  prints "RC5:AUTOON",0
  printh ff ff ff
  }else
  {
  prints "RC5:AUTOOFF",0
  printh ff ff ff
  }

on bPhase.up:
  phase.val++
  if(phase.val>2)
  {
  phase.val=0
  }
  click hPhase,0

on bReportLang.up:
  if(busy.val==0)
  {
  sendme
  printh 52 43 37 30 3a 52 45 50 4f 52 54 4c 41 4e 47 ff ff ff
  }

on hPhase.up:
  if(phase.val==0)
  {
  if(home.lang.val==1)
  {
  bPhase.txt="Initial test"
  }else
  {
  bPhase.txt="Eingangsprüfung"
  }
  }else if(phase.val==1)
  {
  if(home.lang.val==1)
  {
  bPhase.txt="Interim test"
  }else
  {
  bPhase.txt="Zwischenprüfung"
  }
  }else
  {
  if(home.lang.val==1)
  {
  bPhase.txt="Final test"
  }else
  {
  bPhase.txt="Ausgangsprüfung"
  }
  }

on entry.loadend:
  click 39,0
  sendme
  strlen tTicket.txt,draftLen.val
  if(draftLen.val>21)
  {
  if(home.lang.val==1)
  {
  tTicketView.txt="Tap to edit"
  }else
  {
  tTicketView.txt="Tippen zum Bearbeiten"
  }
  }else
  {
  tTicketView.txt=tTicket.txt
  }
  strlen tDevice.txt,draftLen.val
  if(draftLen.val>14)
  {
  if(home.lang.val==1)
  {
  tDeviceView.txt="Tap to edit"
  }else
  {
  tDeviceView.txt="Tippen zum Bearbeiten"
  }
  }else
  {
  tDeviceView.txt=tDevice.txt
  }
  if(home.online.val==1)
  {
  prints "RC61:DRAFT",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh ff ff ff
  }
  route.val=0
  busy.val=0
  cLast.val=useLast.val
  click hPhase,0
  if(sim.val==1)
  {
  if(home.lang.val==1)
  {
  bCreate.txt="Create simulation"
  }else
  {
  bCreate.txt="Simulation erstellen"
  }
  }else if(guided.val==1)
  {
  if(home.lang.val==1)
  {
  bCreate.txt="Start test"
  }else
  {
  bCreate.txt="Prüfung beginnen"
  }
  vis bTester,0
  }

on bCreate.up:
  if(busy.val==0)
  {
  if(home.online.val==0)
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Host disconnected. Your entries are kept."
  }else
  {
  tStatus.txt="Host nicht verbunden. Eingaben bleiben erhalten."
  }
  }else if(tTicket.txt==""||tDevice.txt=="")
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Enter the test number and appliance."
  }else
  {
  tStatus.txt="Prüfnummer und Gerät eingeben."
  }
  }else
  {
  report.ready.val=0
  busy.val=1
  route.val=0
  if(sim.val==1)
  {
  prints "RC3:CREATE",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  }else if(guided.val==1)
  {
  prints "RC6:GUIDE",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  }else
  {
  prints "RC6:IMPORT",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  }
  printh ff ff ff
  }
  }

on bTester.up:
  if(busy.val==0)
  {
  if(home.online.val==0)
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Host disconnected. Your entries are kept."
  }else
  {
  tStatus.txt="Host nicht verbunden. Eingaben bleiben erhalten."
  }
  }else if(tTicket.txt==""||tDevice.txt=="")
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Enter the test number and appliance."
  }else
  {
  tStatus.txt="Prüfnummer und Gerät eingeben."
  }
  }else
  {
  report.ready.val=0
  busy.val=1
  route.val=0
  prints "RC6:EXISTING",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  printh ff ff ff
  }
  }

on bBack.up:
  if(busy.val==0)
  {
  page home
  }

on bHelp.up:
  if(guided.val==1)
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Going back keeps your entries."
  }else
  {
  tStatus.txt="Eingaben bleiben beim Zurückblättern erhalten."
  }
  }else
  {
  if(home.lang.val==1)
  {
  tStatus.txt="Import a new reading or select a saved slot."
  }else
  {
  tStatus.txt="Neue Messung importieren oder einen gespeicherten Slot  wählen."
  }
  }

on tmFlow.timer:
  if(busy.val==1&&report.ready.val==1)
  {
  busy.val=0
  page report
  }
  if(busy.val==1&&home.online.val==0)
  {
  busy.val=0
  if(home.lang.val==1)
  {
  tStatus.txt="Host connection lost. Try again."
  }else
  {
  tStatus.txt="Host-Verbindung verloren. Bitte erneut versuchen."
  }
  }else if(route.val==1)
  {
  busy.val=0
  route.val=0
  page guide
  }else if(route.val==2)
  {
  busy.val=0
  route.val=0
  page importer
  }else if(route.val==3)
  {
  busy.val=0
  route.val=0
  page tester
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  bTemplates.txt="Templates"
  }else
  {
  bTemplates.txt="Vorlagen"
  }
  if(home.lang.val==1)
  {
  bPhase.txt="Initial test"
  }else
  {
  bPhase.txt="Eingangsprüfung"
  }
  if(home.lang.val==1)
  {
  bReportLang.txt="Report: EN"
  }else
  {
  if(home.lang.val==1)
  {
  bReportLang.txt="Report: EN"
  }else
  {
  bReportLang.txt="Bericht: DE"
  }
  }
  if(home.lang.val==1)
  {
  bCreate.txt="Import reading"
  }else
  {
  bCreate.txt="Messung importieren"
  }
  if(home.lang.val==1)
  {
  bTester.txt="Saved reading"
  }else
  {
  bTester.txt="Vorhandene Messung"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back"
  }else
  {
  bBack.txt="Zurück"
  }
  if(home.lang.val==1)
  {
  bHelp.txt="Help"
  }else
  {
  bHelp.txt="Hilfe"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=7
  }else
  {
  pLabel0.pic=6
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=9
  }else
  {
  pLabel1.pic=8
  }
  if(home.lang.val==1)
  {
  pLabel2.pic=11
  }else
  {
  pLabel2.pic=10
  }
  if(home.lang.val==1)
  {
  pLabel3.pic=13
  }else
  {
  pLabel3.pic=12
  }
  if(home.lang.val==1)
  {
  pLabel4.pic=15
  }else
  {
  pLabel4.pic=14
  }
  if(home.lang.val==1)
  {
  pLabel5.pic=17
  }else
  {
  pLabel5.pic=16
  }
