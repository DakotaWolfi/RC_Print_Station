on hEdit0.up:
  if(busy.val==0)
  {
  field.val=0
  page keyboard
  }

on hEdit1.up:
  if(busy.val==0)
  {
  field.val=1
  page keyboard
  }

on hEdit2.up:
  if(busy.val==0&&useLast.val==0&&sim.val==0)
  {
  field.val=5
  page keyboard
  }

on cLast.up:
  useLast.val=cLast.val
  if(useLast.val==1)
  {
  prints "RC5:AUTOON",0
  printh ff ff ff
  }else
  {
  prints "RC5:AUTOOFF",0
  printh ff ff ff
  }

on bPhase.up:
  phase.val++
  if(phase.val>2)
  {
  phase.val=0
  }
  click hPhase,0

on hPhase.up:
  if(phase.val==0)
  {
  bPhase.txt="Eingangsprüfung"
  }else if(phase.val==1)
  {
  bPhase.txt="Zwischenprüfung"
  }else
  {
  bPhase.txt="Ausgangsprüfung"
  }

on entry.loadend:
  sendme
  cLast.val=useLast.val
  click hPhase,0
  if(sim.val==1)
  {
  bCreate.txt="Simulation erstellen"
  }

on bCreate.up:
  if(busy.val==0)
  {
  if(tTicket.txt==""||tDevice.txt=="")
  {
  tStatus.txt="Bitte beide Felder ausfüllen."
  }else if(home.online.val==0)
  {
  tStatus.txt="Host nicht verbunden. Eingaben bleiben erhalten."
  }else
  {
  report.ready.val=0
  if(sim.val==1)
  {
  busy.val=1
  prints "RC3:CREATE",0
  }else
  {
  prints "RC5:REVIEW",0
  }
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  if(sim.val==0)
  {
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  }
  printh ff ff ff
  if(sim.val==0)
  {
  page tester
  }
  }
  }

on bTester.up:
  prints "RC5:BROWSE",0
  printh ff ff ff
  page tester

on bBack.up:
  if(busy.val==0)
  {
  page home
  }

on tmFlow.timer:
  if(busy.val==1&&report.ready.val==1)
  {
  busy.val=0
  page report
  }
  if(busy.val==1&&home.online.val==0)
  {
  busy.val=0
  tStatus.txt="Host-Verbindung verloren. Bitte erneut versuchen."
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  home.tLink.txt="Host nicht verbunden"
  }
