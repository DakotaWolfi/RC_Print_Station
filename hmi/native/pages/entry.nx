on hEdit0.up:
  if(busy.val==0)
  {
  field.val=0
  page keyboard
  }

on bTemplates.up:
  if(busy.val==0&&home.online.val==1)
  {
  prints "RC61:APPLIANCES",0
  printh ff ff ff
  picker.pBack.val=0
  page picker
  }

on hEdit1.up:
  if(busy.val==0)
  {
  field.val=1
  page keyboard
  }

on hEdit2.up:
  if(busy.val==0&&useLast.val==0&&sim.val==0)
  {
  field.val=5
  page keyboard
  }

on cLast.up:
  useLast.val=cLast.val
  if(useLast.val==1)
  {
  prints "RC5:AUTOON",0
  printh ff ff ff
  }else
  {
  prints "RC5:AUTOOFF",0
  printh ff ff ff
  }

on bPhase.up:
  phase.val++
  if(phase.val>2)
  {
  phase.val=0
  }
  click hPhase,0

on hPhase.up:
  if(phase.val==0)
  {
  bPhase.txt="Eingangsprüfung"
  }else if(phase.val==1)
  {
  bPhase.txt="Zwischenprüfung"
  }else
  {
  bPhase.txt="Ausgangsprüfung"
  }

on entry.loadend:
  sendme
  strlen tTicket.txt,draftLen.val
  if(draftLen.val>21)
  {
  tTicketView.txt="Tippen zum Bearbeiten"
  }else
  {
  tTicketView.txt=tTicket.txt
  }
  strlen tDevice.txt,draftLen.val
  if(draftLen.val>14)
  {
  tDeviceView.txt="Tippen zum Bearbeiten"
  }else
  {
  tDeviceView.txt=tDevice.txt
  }
  if(home.online.val==1)
  {
  prints "RC61:DRAFT",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh ff ff ff
  }
  route.val=0
  busy.val=0
  cLast.val=useLast.val
  click hPhase,0
  if(sim.val==1)
  {
  bCreate.txt="Simulation erstellen"
  }else if(guided.val==1)
  {
  bCreate.txt="Prüfung beginnen"
  vis bTester,0
  }

on bCreate.up:
  if(busy.val==0)
  {
  if(home.online.val==0)
  {
  tStatus.txt="Host nicht verbunden. Eingaben bleiben erhalten."
  }else if(tTicket.txt==""||tDevice.txt=="")
  {
  tStatus.txt="Prüfnummer und Gerät eingeben."
  }else
  {
  report.ready.val=0
  busy.val=1
  route.val=0
  if(sim.val==1)
  {
  prints "RC3:CREATE",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  }else if(guided.val==1)
  {
  prints "RC6:GUIDE",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  }else
  {
  prints "RC6:IMPORT",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  }
  printh ff ff ff
  }
  }

on bTester.up:
  if(busy.val==0)
  {
  if(home.online.val==0)
  {
  tStatus.txt="Host nicht verbunden. Eingaben bleiben erhalten."
  }else if(tTicket.txt==""||tDevice.txt=="")
  {
  tStatus.txt="Prüfnummer und Gerät eingeben."
  }else
  {
  report.ready.val=0
  busy.val=1
  route.val=0
  prints "RC6:EXISTING",0
  printh 00
  prints tTicket.txt,0
  printh 00
  prints tDevice.txt,0
  printh 00
  prints tSlot.txt,0
  printh 00
  covx phase.val,vArg.txt,0,0
  prints vArg.txt,0
  printh 00
  covx useLast.val,vArg.txt,0,0
  prints vArg.txt,0
  printh ff ff ff
  }
  }

on bBack.up:
  if(busy.val==0)
  {
  page home
  }

on bHelp.up:
  if(guided.val==1)
  {
  tStatus.txt="Eingaben bleiben beim Zurückblättern erhalten."
  }else
  {
  tStatus.txt="Neue Messung importieren oder einen gespeicherten Slot wählen."
  }

on tmFlow.timer:
  if(busy.val==1&&report.ready.val==1)
  {
  busy.val=0
  page report
  }
  if(busy.val==1&&home.online.val==0)
  {
  busy.val=0
  tStatus.txt="Host-Verbindung verloren. Bitte erneut versuchen."
  }else if(route.val==1)
  {
  busy.val=0
  route.val=0
  page guide
  }else if(route.val==2)
  {
  busy.val=0
  route.val=0
  page importer
  }else if(route.val==3)
  {
  busy.val=0
  route.val=0
  page tester
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  home.tLink.txt="Host nicht verbunden"
  }
