  }

on hCount.up:
  strlen input.txt,count.val
  if(count.val>21)
  {
  kTail.val=count.val-21
  substr input.txt,tInput.txt,kTail.val,21
  tInput.txt="..."+tInput.txt
  }else
  {
  tInput.txt=input.txt
  }
  covx count.val,tHint.txt,0,0
  if(home.lang.val==1)
  {
  tHint.txt+=" characters / max. "
  }else
  {
  tHint.txt+=" Zeichen  /  max. "
  }
  covx limit.val,tLimit.txt,0,0
  tHint.txt+=tLimit.txt

on bShift.up:
  shift.val=1-shift.val
  mode.val=0
  click hLayout,0

on bDel.up:
  input.txt-=1
  secret.txt-=1
  click hCount,0

on bMode.up:
  mode.val++
  if(mode.val>2)
  {
  mode.val=0
  }
  click hLayout,0

on bCaps.up:
  caps.val=1-caps.val
  shift.val=0
  mode.val=0
  click hLayout,0

on bSpace.up:
  vKey.txt=" "
  click hAdd,0

on bClear.up:
  input.txt=""
  secret.txt=""
  click hCount,0

on bCancel.up:
  secret.txt=""
  input.txt=""
  if(entry.field.val==2)
  {
  page wjoin
  }else if(entry.field.val>2&&entry.field.val<5)
  {
  page printer
  }else if(entry.field.val==6)
  {
  page picker
  }else if(entry.field.val==7)
  {
  page guide
  }else
  {
  page entry
  }

on bOK.up:
  if(entry.field.val==2)
  {
  if(home.online.val==1)
  {
  prints "RC4:PASS",0
  printh 00
  prints secret.txt,0
  printh ff ff ff
  }
  secret.txt=""
  input.txt=""
  page wjoin
  }else if(entry.field.val>2&&entry.field.val<5)
  {
  if(home.online.val==1)
  {
  if(entry.field.val==3)
  {
  prints "RC4:IP",0
  }else
  {
  prints "RC4:PORT",0
  }
  printh 00
  prints input.txt,0
  printh ff ff ff
  }
  input.txt=""
  page printer
  }else if(entry.field.val>5)
  {
  if(entry.field.val==6)
  {
  if(home.online.val==1)
  {
  prints "RC61:NAME",0
  printh 00
  prints input.txt,0
  printh ff ff ff
  }
  page picker
  }else
  {
  guide.eRemarks.txt=input.txt
  page guide
  }
  }else
  {
  if(entry.field.val==0)
  {
  entry.tTicket.txt=input.txt
  }else if(entry.field.val==1)
  {
  entry.tDevice.txt=input.txt
  }else
  {
  entry.tSlot.txt=input.txt
  }
  entry.tStatus.txt=""
  page entry
  }

on keyboard.unload:
  secret.txt=""
  vKey.txt=""
  input.txt=""

on keyboard.loadend:
  click 75,0
  sendme
  mode.val=0
  shift.val=0
  caps.val=0
  secret.txt=""
  if(entry.field.val==0)
  {
  input.txt=entry.tTicket.txt
  if(home.lang.val==1)
  {
  tField.txt="Repair number"
  }else
  {
  tField.txt="Prüfnummer"
  }
  limit.val=32
  }else if(entry.field.val==1)
  {
  input.txt=entry.tDevice.txt
  if(home.lang.val==1)
  {
  tField.txt="Appliance description"
  }else
  {
  tField.txt="Gerätebeschreibung"
  }
  limit.val=64
  }else if(entry.field.val==2)
  {
  input.txt=""
  if(home.lang.val==1)
  {
  tField.txt="Wi-Fi password"
  }else
  {
  tField.txt="WLAN-Passwort"
  }
  limit.val=64
  }else if(entry.field.val==3)
  {
  input.txt=settings.editText.txt
  if(home.lang.val==1)
  {
  tField.txt="Printer IPv4 address"
  }else
  {
  tField.txt="Drucker-IPv4-Adresse"
  }
  limit.val=15
  }else if(entry.field.val==4)
  {
  input.txt=settings.editText.txt
  if(home.lang.val==1)
  {
  tField.txt="Printer TCP port"
  }else
  {
  tField.txt="Drucker-TCP-Port"
  }
  limit.val=5
  }else if(entry.field.val==5)
  {
  input.txt=entry.tSlot.txt
  if(home.lang.val==1)
  {
  tField.txt="Test memory slot"
  }else
  {
  tField.txt="Prüfspeichernummer"
  }
  limit.val=3
  }else if(entry.field.val==6)
  {
  input.txt=picker.pEdit.txt
  if(home.lang.val==1)
  {
  tField.txt="Examiner"
  }else
  {
  tField.txt="Prüfperson"
  }
  limit.val=48
  }else
  {
  input.txt=guide.eRemarks.txt
  if(home.lang.val==1)
  {
  tField.txt="Remarks"
  }else
  {
  tField.txt="Bemerkung"
  }
  limit.val=64
  }
  settings.editText.txt=""
  click hLayout,0
  click hCount,0

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  tField.txt="Entry"
  }else
  {
  tField.txt="Eingabe"
  }
  if(home.lang.val==1)
  {
  bSpace.txt="Space"
  }else
  {
  bSpace.txt="Leerzeichen"
  }
  if(home.lang.val==1)
  {
  bClear.txt="Clear"
  }else
  {
  bClear.txt="Leeren"
  }
  if(home.lang.val==1)
  {
  bCancel.txt="Cancel"
  }else
  {
  bCancel.txt="Abbrechen"
  }
  if(home.lang.val==1)
  {
  bOK.txt="Apply"
  }else
  {
  bOK.txt="Übernehmen"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=58
  }else
  {
  pLabel0.pic=57
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=60
  }else
  {
  pLabel1.pic=59
  }
