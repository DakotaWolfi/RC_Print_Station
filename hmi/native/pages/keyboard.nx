on hAdd.up:
  strlen input.txt,count.val
  if(count.val<limit.val)
  {
  if(entry.field.val==2)
  {
  secret.txt+=vKey.txt
  input.txt+="*"
  }else
  {
  input.txt+=vKey.txt
  }
  }
  vKey.txt=""
  click hCount,0

on k0.up:
  vKey.txt=k0.txt
