on bRow0.up:
  if(home.online.val==1&&pending.val==0)
  {
  pending.val=1
  report.ready.val=0
  prints "RC3:OPEN:0",0
  printh ff ff ff
  }

on bRow1.up:
  if(home.online.val==1&&pending.val==0)
  {
  pending.val=1
  report.ready.val=0
  prints "RC3:OPEN:1",0
  printh ff ff ff
  }

on bRow2.up:
  if(home.online.val==1&&pending.val==0)
  {
  pending.val=1
  report.ready.val=0
  prints "RC3:OPEN:2",0
  printh ff ff ff
  }

on bRow3.up:
  if(home.online.val==1&&pending.val==0)
  {
  pending.val=1
  report.ready.val=0
  prints "RC3:OPEN:3",0
  printh ff ff ff
  }

on bRow4.up:
  if(home.online.val==1&&pending.val==0)
  {
  pending.val=1
  report.ready.val=0
  prints "RC3:OPEN:4",0
  printh ff ff ff
  }

on bBack.up:
  page home

on history.loadend:
  click 14,0
  sendme
  pending.val=0
  prints "RC3:HISTORY",0
  printh ff ff ff

on tmFlow.timer:
  if(pending.val==1&&report.ready.val==1)
  {
  pending.val=0
  page report
  }
  if(pending.val==1&&home.online.val==0)
  {
  pending.val=0
  if(home.lang.val==1)
  {
  tStatus.txt="Host disconnected. Try again."
  }else
  {
  tStatus.txt="Host nicht verbunden. Bitte erneut versuchen."
  }
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  bBack.txt="Home"
  }else
  {
  bBack.txt="Hauptmenü"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=45
  }else
  {
  pLabel0.pic=44
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=47
  }else
  {
  pLabel1.pic=46
  }
