on bwifi.up:
  page wifi

on bprinter.up:
  page printer

on breceipt.up:
  page receipt

on bsystem.up:
  page system

on bBack.up:
  page home

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  home.tLink.txt="Host nicht verbunden"
  }

on settings.loadend:
  sendme
