on mRow0.up:
  if(mCount.val>0&&home.online.val==1)
  {
  prints "RC5:SEL:0",0
  printh ff ff ff
  }

on mRow1.up:
  if(mCount.val>1&&home.online.val==1)
  {
  prints "RC5:SEL:1",0
  printh ff ff ff
  }

on mRow2.up:
  if(mCount.val>2&&home.online.val==1)
  {
  prints "RC5:SEL:2",0
  printh ff ff ff
  }

on mRow3.up:
  if(mCount.val>3&&home.online.val==1)
  {
  prints "RC5:SEL:3",0
  printh ff ff ff
  }

on bPrev.up:
  if(mPrev.val==1)
  {
  prints "RC5:PREV",0
  printh ff ff ff
  }

on bNext.up:
  if(mNext.val==1)
  {
  prints "RC5:NEXT",0
  printh ff ff ff
  }

on bUse.up:
  if(mReady.val==1&&home.online.val==1)
  {
  mReady.val=0
  mSaving.val=1
  prints "RC5:USE",0
  printh ff ff ff
  }

on bBack.up:
  page entry

on tmFlow.timer:
  if(mSaving.val==1&&report.ready.val==1)
  {
  mSaving.val=0
  page report
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  mLink.txt="Waiting for host"
  }else
  {
  mLink.txt="Warte auf Host"
  }
  if(home.lang.val==1)
  {
  mImport.txt="No imports yet"
  }else
  {
  mImport.txt="Noch kein Import"
  }
  if(home.lang.val==1)
  {
  bPrev.txt="Previous"
  }else
  {
  bPrev.txt="Vorherige"
  }
  if(home.lang.val==1)
  {
  bNext.txt="Next"
  }else
  {
  bNext.txt="Weitere"
  }
  if(home.lang.val==1)
  {
  mSelected.txt="No reading selected"
  }else
  {
  mSelected.txt="Keine Messung ausgewählt"
  }
  if(home.lang.val==1)
  {
  bUse.txt="Confirm reading"
  }else
  {
  bUse.txt="Messung bestätigen"
  }
  if(home.lang.val==1)
  {
  bBack.txt="Back to details"
  }else
  {
  bBack.txt="Zurück zur Eingabe"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=107
  }else
  {
  pLabel0.pic=106
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=109
  }else
  {
  pLabel1.pic=108
  }

on tester.loadend:
  click hLocale,0
  sendme
