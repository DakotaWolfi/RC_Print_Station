on hLogo.up:
  printh 52 43 37 31 3a 4c 4f 47 4f ff ff ff

on hVersion.down:
  tmEng.en=0
  tmEng.en=1

on hVersion.up:
  tmEng.en=0

on tmEng.timer:
  tmEng.en=0
  printh 52 43 37 31 3a 45 4e 47 49 4e 45 45 52 ff ff ff

on bLang.up:
  sendme
  printh 52 43 37 30 3a 4c 41 4e 47 ff ff ff

on bNew.up:
  entry.inProgress.val=1
  entry.tTicket.txt=""
  entry.tDevice.txt=""
  entry.tStatus.txt=""
  entry.tSlot.txt=""
  guide.eRemarks.txt=""
  entry.phase.val=0
  entry.useLast.val=1
  entry.busy.val=0
  entry.route.val=0
  entry.guided.val=1
  prints "RC6:NEW",0
  printh ff ff ff
  page entry

on bDirect.up:
  entry.inProgress.val=1
  entry.tTicket.txt=""
  entry.tDevice.txt=""
  entry.tStatus.txt=""
  entry.tSlot.txt=""
  guide.eRemarks.txt=""
  entry.phase.val=0
  entry.useLast.val=1
  entry.busy.val=0
  entry.route.val=0
  entry.guided.val=0
  prints "RC6:NEW",0
  printh ff ff ff
  page entry

on bHistory.up:
  page history

on bSettings.up:
  page settings

on bLast.up:
  if(home.online.val==1)
  {
  report.ready.val=0
  pending.val=1
  prints "RC3:LAST",0
  printh ff ff ff
  }else
  {
  if(home.lang.val==1)
  {
  tHint.txt="Check the host connection."
  }else
  {
  tHint.txt="Bitte Host-Verbindung prüfen."
  }
  }

on bResume.up:
  page entry

on home.loadend:
  click 25,0
  sendme
  vis bResume,0
  if(entry.inProgress.val==1)
  {
  vis bResume,1
  }

on tmFlow.timer:
  if(shownLang.val!=lang.val)
  {
  click 25,0
  }
  if(pending.val==1&&report.ready.val==1)
  {
  pending.val=0
  page report
  }
  if(pending.val==1&&online.val==0)
  {
  pending.val=0
  if(home.lang.val==1)
  {
  tHint.txt="Host disconnected. Try again."
  }else
  {
  tHint.txt="Host nicht verbunden. Bitte erneut versuchen."
  }
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  tSlogan.txt="A second life starts with a repair."
  }else
  {
  if(home.lang.val==1)
  {
  tSlogan.txt="A second life begins with a repair."
  }else
  {
  tSlogan.txt="Ein zweites Leben beginnt mit einer  Reparatur."
  }
  }
  if(home.lang.val==1)
  {
  bLang.txt="EN / DE"
  }else
  {
  bLang.txt="DE / EN"
  }
  if(home.lang.val==1)
  {
  bNew.txt="Guided test"
  }else
  {
  bNew.txt="Geführte Prüfung"
  }
  if(home.lang.val==1)
  {
  bDirect.txt="Direct"
  }else
  {
  bDirect.txt="Direkt"
  }
  if(home.lang.val==1)
  {
  bHistory.txt="History"
  }else
  {
  bHistory.txt="Verlauf"
  }
  if(home.lang.val==1)
  {
  bLast.txt="Last report"
  }else
  {
  bLast.txt="Letztes Protokoll"
  }
  if(home.lang.val==1)
  {
  bResume.txt="Resume draft"
  }else
  {
  bResume.txt="Entwurf fortsetzen"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=50
  }else
  {
  pLabel0.pic=49
  }
  shownLang.val=lang.val
  if(home.lang.val==1)
  {
  printh 52 43 37 31 3a 4c 4f 43 41 4c 45 3a 45 4e ff ff ff
  }else
  {
  printh 52 43 37 31 3a 4c 4f 43 41 4c 45 3a 44 45 ff ff ff
  }
