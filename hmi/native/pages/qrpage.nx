on bBack.up:
  page report

on qrpage.loadend:
  click 12,0
  sendme
  shown.val=0
  vis qrReport,0
  prints "RC3:QR",0
  printh ff ff ff

on tmFlow.timer:
  if(qReady.val==1&&shown.val==0)
  {
  vis qrReport,1
  shown.val=1
  }
  if(qReady.val!=1&&shown.val==1)
  {
  vis qrReport,0
  shown.val=0
  }
  if(home.online.val==0)
  {
  qReady.val=2
  if(home.lang.val==1)
  {
  tNote.txt="Host disconnected. Check the connection."
  }else
  {
  tNote.txt="Host nicht verbunden. Bitte Verbindung prüfen."
  }
  }

on tmLink.timer:
  home.age.val++
  if(home.age.val>6)
  {
  home.online.val=0
  if(home.lang.val==1)
  {
  home.tLink.txt="Host disconnected"
  }else
  {
  home.tLink.txt="Host nicht verbunden"
  }
  }

on hLocale.up:
  if(home.lang.val==1)
  {
  bBack.txt="Back to report"
  }else
  {
  bBack.txt="Zurück zum Bericht"
  }
  if(home.lang.val==1)
  {
  pLabel0.pic=83
  }else
  {
  pLabel0.pic=82
  }
  if(home.lang.val==1)
  {
  pLabel1.pic=85
  }else
  {
  pLabel1.pic=84
  }
